# daneoword — environment template. Copy to .env only for values the APP needs at runtime.
#
# WARNING: `pltt dev --sandbox` / `pltt publish` upload every key in .env (except
# reserved PALETTE_* keys and NEXT_PUBLIC_*) as an encrypted plugin secret.
# Never put publish/deploy tokens here — store them with `pltt login`
# (~/.palette/config.json) or export PALETTE_<ENV>_TOKEN in your shell.
#
# This app declares no runtime secrets today, so a real .env is not required.

# Optional: per-environment sandbox targets (reserved keys, not uploaded)
PALETTE_DEV_URL=https://dev-api.example
PALETTE_DEV_TOKEN=pltt_xxxxx
PALETTE_QA_URL=https://qa-api.example
PALETTE_QA_TOKEN=pltt_xxxxx
